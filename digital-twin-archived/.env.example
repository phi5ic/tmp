# Copy this file to .env and fill in values for local development.
# Vite exposes only variables prefixed with VITE_ to the browser bundle.

# URL of the PI-GNN webhook server (webhook_server.py).
# Leave empty to use the Vite dev proxy (see vite.config.js).
# Set to the full Code Engine app URL for production builds.
VITE_BACKEND_URL=
